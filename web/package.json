{
  "name": "fullstack-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:ssr": "tsx server.ts",
    "build": "tsc -b && vite build",
    "build:ssr": "npm run build:client && npm run build:server",
    "build:client": "vite build --outDir dist/client",
    "build:server": "vite build --ssr src/ssr-entry.tsx --outDir dist/server",
    "preview:ssr": "NODE_ENV=production tsx server.ts",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest"
  },
  "dependencies": {
    "@ant-design/charts": "^2.6.7",
    "@ant-design/icons": "^5.5.0",
    "@antv/g2": "^5.4.8",
    "@chenglou/pretext": "^0.0.5",
    "@tanstack/react-query": "^5.60.0",
    "antd": "^5.22.0",
    "axios": "^1.7.0",
    "axios-retry": "^4.5.0",
    "clsx": "^2.1.0",
    "cookie-parser": "^1.4.7",
    "dayjs": "^1.11.0",
    "decimal.js": "^10.6.0",
    "express": "^5.2.1",
    "nanoid": "^5.1.7",
    "node-forge": "^1.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.14.0",
    "react-router-dom": "^7.0.0",
    "react-toastify": "^11.0.5",
    "ts-pattern": "^5.9.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.0"
