# 远程数据库连接配置模板
# 复制为 .env.remote.local 后填入真实值（.env.remote.local 已被 .gitignore 忽略，不会进版本库）
#   cp .env.remote.local.example .env.remote.local
# 这些变量通过 Viper 的 APP_ 前缀覆盖 config.yaml 中的 mysql 配置
# 启动：在项目根目录执行 make dev-server-remote
#
# 注意事项：
# 1. 用户名通常不是 root。宝塔/面板创建数据库时一般生成与库同名的专用账号
#    （如库名 energytest，账号也是 energytest），用错账号会报 ERROR 1045。
# 2. 密码如含 ( ) ! * ? $ 空格 等特殊字符，必须用【单引号】包裹，
#    否则 make 的 /bin/sh 解析会报语法错误或截断密码。
# 3. 远程库需在 MySQL 侧授权当前开发机来源 IP（宝塔→数据库→权限改为指定IP/所有人），
#    否则报 ERROR 1130 Host not allowed。

APP_MYSQL_HOST=your-remote-host
APP_MYSQL_PORT=3306
APP_MYSQL_USERNAME=your-db-user
APP_MYSQL_PASSWORD='your-password'
APP_MYSQL_DATABASE=energytest
